{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom" xmlns:content="http://purl.org/rss/1.0/modules/content/">
  <channel>
    <title>{{ site.Title }}</title>
    <link>{{ site.BaseURL }}</link>
    <description>Full posts from Dexter Bosley.</description>
    <generator>Hugo</generator>
    <language>{{ site.LanguageCode }}</language>
    {{- with (index (sort site.RegularPages "Date" "desc") 0) }}
    <lastBuildDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</lastBuildDate>
    {{- end }}
    <atom:link href="{{ "/index.xml" | absURL }}" rel="self" type="application/rss+xml" />
    {{- $sitePosts := where site.RegularPages "Section" "in" site.Params.mainSections }}
    {{- $pages := cond .IsHome $sitePosts .Pages }}
    {{- range first 50 (sort $pages "Date" "desc") }}
    {{- $content := .Content }}
    {{- $content = $content | replaceRE "(href|src)=\"/" (printf "$1=\"%s" site.BaseURL) }}
    {{- $content = $content | replaceRE "(srcset)=\"/" (printf "$1=\"%s" site.BaseURL) }}
    {{- $content = $content | replaceRE ", /" (printf ", %s" site.BaseURL) }}
    <item>
      <title>{{ .Title }}</title>
      <link>{{ .Permalink }}</link>
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</pubDate>
      <guid>{{ .Permalink }}</guid>
      <description>{{ .Params.description | default (.Summary | plainify) }}</description>
      {{ printf "<content:encoded><![CDATA[%s]]></content:encoded>" $content | safeHTML }}
    </item>
    {{- end }}
  </channel>
</rss>
